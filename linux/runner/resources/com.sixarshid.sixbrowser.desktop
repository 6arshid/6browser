[Desktop Entry]
# Launcher entry. When installing, copy this to ~/.local/share/applications/,
# app_icon.png to ~/.local/share/icons/hicolor/256x256/apps/com.sixarshid.sixbrowser.png,
# and point Exec at the installed binary. The file name must match
# APPLICATION_ID so Wayland docks pick up the icon.
Type=Application
Name=6browser
Comment=Web browser
Exec=browser6 %U
Icon=com.sixarshid.sixbrowser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=com.sixarshid.sixbrowser
